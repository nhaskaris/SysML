# Copy to .env:  cp template.env .env
# Release tags used when building the images.
# If %publish fails, align both on the same release (e.g. 2026-04).

# SysML-v2-API-Services tag (latest available: 2026-04)
API_TAG=2026-04

# SysML-v2-Release (Jupyter kernel) tag (newer ones exist, e.g. 2026-09.1)
RELEASE_TAG=2026-08

# Host ports (change if the defaults are already in use on your machine).
# Only the host side changes; containers still talk to each other on 5432/9000.
POSTGRES_PORT=5432
API_PORT=9000
JUPYTER_PORT=8888
